  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:3001/permission",
            "timeout": 1210
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"c:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\.claude\\hooks\\signal-detector.ps1\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"if (-not (Get-CimInstance Win32_Process -Filter \\\"Name='bun.exe'\\\" -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -match 'run index\\.ts' })) { Start-Process bun -ArgumentList 'run','index.ts' -WorkingDirectory 'C:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\infra\\bot' -WindowStyle Hidden -RedirectStandardOutput 'C:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\infra\\bot\\bot-start.log' -RedirectStandardError 'C:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\infra\\bot\\bot-start.err.log' }\"",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"c:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\.claude\\hooks\\figees-injector.ps1\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"c:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\.claude\\hooks\\garde-git-add.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"c:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\.claude\\hooks\\sync-agents-md.py\"",
            "statusMessage": "Sync AGENTS.md (miroir Kimi)..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$input = $input -join ''; $data = $input | ConvertFrom-Json -ErrorAction SilentlyContinue; $path = if ($data.tool_input.path) { $data.tool_input.path } elseif ($data.tool_input.file_path) { $data.tool_input.file_path } else { '' }; if ($path -match '[\\/]max-adventure[\\/].*\\.ts$') { Set-Location 'c:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\studio\\max-adventure'; npx tsc --noEmit 2>&1 | Select-Object -First 20 } else { Write-Output 'TSC skip (non-TS or non-max-adventure file)' }\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); if echo \"$INPUT\" | grep -q \"narration.*INBOX\"; then cd \"c:/ProjetsPerso/Claude_Projects/MaxPlay\" && git commit -m \"inbox: dump $(date +%Y-%m-%d)\" -- studio/narration/INBOX.md 2>/dev/null || true; fi'",
            "statusMessage": "Sauvegarde INBOX narration...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"c:\\ProjetsPerso\\Claude_Projects\\MaxPlay\\.claude\\hooks\\pmo-check.ps1\""
          }
        ]
      }
    ]
  },
  "allowedHttpHookUrls": [
    "http://localhost:3001/*"
  ],
  "effortLevel": "medium"
}
