# MCP llm-copains — logs auto des appels LLM créatifs (filet de sécurité option A 2026-05-13)
# Chaque appel ask_kimi/ask_kimi_payant/ask_deepseek/ask_grok dump le résultat ici
# pour récupération si main thread crash avant Write tool. Voir infra/mcp/MODELS.md.
infra/mcp/logs/
site/img/dinos/brutes/
# Zones de staging images dino (bruts HD ChatGPT/Grok, non déployés — gardés en local pour retouches)
site/img/dinos/_new-xxl/
site/img/dinos/_new-coloriage/
site/img/dinos/_new-sprites/
site/img/dinos/_new-headshots/
site/img/dinos/_new-ombre/
site/img/dinos/coloriage-test/

# Harnais de test mini-jeux (EP-038) — screenshots/artefacts de run, pas versionnés
studio/minijeux/tests/.artifacts/

# Worktrees d'agents en arrière-plan (Agent tool isolation:worktree) — registered+locked, hors versionning
.claude/worktrees/
debug.log
site/img/dinos/_new-traces/

# Payload hook Stop Kimi Code (runtime, jamais versionne)
.kimi-code/hooks/stop-payload.jsonl

infra/bot/*.log

# Referentiel de contenu — dump machine regenerable (853 Ko, reecrit entierement a chaque run).
# Le tableau de bord lisible _ETAT-CONTENU.md, lui, EST versionne. Le Lot 1 ajoutera une
# base d empreintes compacte qui sera versionnee elle aussi.
studio/referentiel/registre.json
studio/referentiel/plan-generation.json
