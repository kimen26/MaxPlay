pageType: table_of_contents
background:
  type: solid
  color: "$background"
elements:
  - elementId: page-title
    elementType: text
    bounds: [60, 40, 500, 50]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>AU PROGRAMME</p>

  - elementId: accent-line
    elementType: shape
    bounds: [60, 95, 120, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 2, color: "$accent"}

  - elementId: card-bg-1
    elementType: shape
    bounds: [60, 120, 180, 130]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "$cardBg"}

  - elementId: card-text-1
    elementType: text
    bounds: [60, 120, 180, 130]
    content:
      color: "$text"
      align: [center, middle]
      text: |
        <p><span style="font-size:36px; color:$accent;">01</span></p>
        <p style="margin-top:8px"><span style="font-size:16px; color:$text; font-family:Liter;">Spinosaurus</span></p>

