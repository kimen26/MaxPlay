pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: nav-text
    elementType: text
    bounds: [60, 18, 400, 20]
    content:
      fontSize: 12
      color: "#8BA3B080"
      fontFamily: "Liter"
      letterSpacing: 2
      wrap: false
      text: |
        <p>GÉANTS DES MERS PRÉHISTORIQUES</p>

  - elementId: page-num
    elementType: text
    bounds: [1180, 680, 60, 25]
    content:
      fontSize: 14
      color: "$muted"
      fontFamily: "Liter"
      align: [right, middle]
      wrap: false
      text: |
        <p>09</p>

  - elementId: animal-image
    elementType: image
    bounds: [60, 55, 500, 380]
    src: "https://kimi-web-img.moonshot.cn/img/media.istockphoto.com/75dbec267055c2587ac97f3134919b7cc3c6e916.jpg"
    shapeName: roundRect
    adjustments: [8000]
    fit: {mode: cover}

  - elementId: animal-name
    elementType: text
    bounds: [590, 55, 630, 45]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>DAKOSAURUS</p>

  - elementId: scientific-name
    elementType: text
    bounds: [590, 102, 630, 25]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p><em>D. maximus</em>  ·  Le "crocodile marin"</p>

  - elementId: accent-line
    elementType: shape
    bounds: [590, 135, 100, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 2, color: "$accent"}

  - elementId: card-size
    elementType: shape
    bounds: [590, 155, 300, 80]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "$cardBg"}

  - elementId: icon-size
