pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: nav-text
    elementType: text
    bounds: [60, 18, 400, 20]
    content:
      fontSize: 12
      color: "#8BA3B080"
      fontFamily: "Liter"
      letterSpacing: 2
      wrap: false
      text: |
        <p>GÉANTS DES MERS PRÉHISTORIQUES</p>

  - elementId: page-num
    elementType: text
    bounds: [1180, 680, 60, 25]
    content:
      fontSize: 14
      color: "$muted"
      fontFamily: "Liter"
      align: [right, middle]
      wrap: false
      text: |
        <p>08</p>

  - elementId: animal-image
    elementType: image
    bounds: [60, 55, 500, 380]
    src: "https://kimi-web-img.moonshot.cn/img/images.dinosaurpictures.org/46ebd2525cb04e938f3e2eddbf93b4b069a51d26.jpg"
    shapeName: roundRect
    adjustments: [8000]
    fit: {mode: cover}

  - elementId: animal-name
    elementType: text
    bounds: [590, 55, 630, 45]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>HYDRORION</p>

  - elementId: scientific-name
    elementType: text
    bounds: [590, 102, 630, 25]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p><em>H. brachypterygius</em>  ·  Le "chasseur d'eau"</p>

  - elementId: accent-line
    elementType: shape
    bounds: [590, 135, 100, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 2, color: "$accent"}

  - elementId: card-size
    elementType: shape
    bounds: [590, 155, 300, 80]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "$cardBg"}

  - elementId: icon-size
    elementType: icon
    bounds: [605, 165, 24, 24]
    iconName: "fas:ruler-horizontal"
    fill: {type: solid, color: "$accent"}

  - elementId: label-size
    elementType: text
    bounds: [638, 165, 160, 22]
    content:
      style: "$label"
      align: [left, middle]
      wrap: false
      text: |
        <p>TAILLE / POIDS</p>

  - elementId: data-size
    elementType: text
    bounds: [605, 195, 270, 28]
    content:
      style: "$data"
      align: [left, middle]
      wrap: false
      text: |
        <p>4 m  ·  ~300-500 kg</p>

  - elementId: card-era
